rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Anyone can read the problem sheet. Only admins can change it.
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      // A user can read their own profile; admins can read any.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // New accounts always start as a regular user.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user';

      // Users can edit their profile but never change their own role.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      // Progress is private to its owner.
      match /progress/{questionId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
